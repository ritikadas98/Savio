# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for scripts/apply-migrations.js and scripts/verify-rls.mjs
# Format: postgresql://postgres:<db_password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=
# Personal access token for `supabase functions deploy`. Get one at
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
DEMO_PRIYA_PASSWORD=

# Vertex AI on GCP (used only by Edge Functions)
# Gemini models are accessed via aiplatform.googleapis.com using a GCP service
# account. The old GEMINI_API_KEY path has been removed.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
# Path to the service-account JSON file (gitignored). Used by scripts/push-gcp-secrets.mjs
# to push GCP_SA_JSON to Supabase as a single-line secret.
GCP_SA_KEY_PATH=.gcp-sa.json
# Model name passed to Vertex AI's generateContent endpoint
GEMINI_MODEL_ID=gemini-2.5-flash

# Feature flags
VITE_ENABLE_DEBUG_CONTEXT_PANEL=true
