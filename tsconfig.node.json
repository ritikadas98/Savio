{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    /* Project-reference requirements (tsc -b under TS 6.0):
       composite: true is mandatory for any referenced project.
       emit can't be disabled — replace noEmit with emitDeclarationOnly
       (only .d.ts files emit, no .js output). outDir routes them into
       the existing gitignored node_modules/.tmp cache. */
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/node-types",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
